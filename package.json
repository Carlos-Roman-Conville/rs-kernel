{
  "name": "@rex/kernel",
  "version": "0.1.1",
  "description": "The Kernel: simulation time and scheduling, events, identifiers, units, seeded random streams, snapshots and replay, cross-engine transactions. No scientific or economic formula; no engine or game imports.",
  "private": true,
  "files": ["dist", "src", "data", "README.md"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check-registry": "node --experimental-strip-types scripts/check-registry.ts"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  }
}
